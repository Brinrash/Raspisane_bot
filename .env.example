# MAX Bot API token. Получается в официальной платформе MAX для разработчиков.
MAX_BOT_TOKEN=PASTE_MAX_BOT_TOKEN_HERE

# Ваш MAX user_id. Получить в боте командой /myid. Можно несколько ID через запятую.
MAX_ADMIN_IDS=

# Необязательно: ID исходного канала, публикации которого ты будешь ПЕРЕСЫЛАТЬ боту в личный диалог.
# Бот проверяет link.chat_id пересланной публикации; добавлять бота в исходный канал не нужно.
# Само по себе это значение не даёт API-доступа к истории чужого канала.
MAX_SOURCE_CHAT_ID=

# Часовой пояс расписания.
TIMEZONE=Europe/Moscow

# Long Polling: для локальной разработки/тестирования, 1-90 секунд.
# Для постоянной production-работы MAX рекомендует Webhook.
MAX_POLL_TIMEOUT=60

# Bothost Webhook (оставь пустыми для локального Long Polling).
MAX_WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_PATH=/webhook
PORT=3000

# Необязательно: путь к доверенному набору сертификатов, если TLS MAX не работает.
MAX_CA_BUNDLE=

# Ограничение размера входящего XLSX/PDF в мегабайтах.
MAX_UPLOAD_MB=20

# Уведомлять пользователей, чьи группы изменились после обновления.
NOTIFY_USERS_ON_UPDATE=true

# Каталог постоянных данных. Локально можно не задавать; на Bothost укажи /app/data.
DATA_DIR=

# Автоматически проверять официальный сайт с PDF-расписанием.
SITE_MONITOR_ENABLED=true
SITE_PAGE_URL=https://spt-11.gosuslugi.ru/svedeniya-ob-obrazovatelnoy-organizatsii/dokumenty/raspisanie-zanyatiy-s-01092026-po-04092026.html
# Четыре проверки в час: 12:00, 12:15, 12:30, 12:45 ... 23:45.
SITE_CHECK_INTERVAL_MINUTES=15
SITE_CHECK_START_HOUR=12
SITE_CHECK_END_HOUR=24
